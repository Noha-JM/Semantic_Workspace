# ============================================================
# Semantic Research Workspace — example environment config
# Copy to .env and adjust. NEVER commit real .env files.
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=semantic_workspace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- MinIO ----------
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=papers

# ---------- Embeddings ----------
# fastembed model name and its vector dimension (must match DB VECTOR(384))
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---------- Neo4j (GraphRAG) ----------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# ---------- External APIs ----------
OPENALEX_API_KEY=
CORE_API_KEY=

# ---------- LLM (grounded generation) ----------
# Leave empty to use the deterministic extractive generator (no external LLM).
LLM_PROVIDER=none            # none | openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------- Backend / CORS ----------
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PORT=5174

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000
